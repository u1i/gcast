def handle_volume(args):
    chromecasts, browser = discover_devices(args.timeout, args.verbose)
    if not chromecasts:
        print("No devices found.")
        browser.stop_discovery()
        return

    target = select_device(chromecasts, args.device)
    if not target:
        print("No device selected.")
        browser.stop_discovery()
        return

    try:
        if args.verbose:
            print(f"Connecting to {target.name}...")
        target.wait()
        
        # If --set is provided, change the volume
        if args.set is not None:
            if args.verbose:
                print(f"Setting volume to {args.set}...")
            target.set_volume(args.set)
            # Give it a moment to apply before reading back
            time.sleep(1)
            # wait for status update might be needed or we just pull it
            target.wait()
            
        current_vol = target.status.volume_level
        name = getattr(target, 'name', 'Device')
        if current_vol is not None:
            print(f"Volume for {name} is {current_vol:.2f} ({int(current_vol * 100)}%)")
        else:
            print(f"Could not read volume for {name}.")
            
    except Exception as e:
        print(f"Error: {e}")
    finally:
        browser.stop_discovery()

def handle_status(args):
    chromecasts, browser = discover_devices(args.timeout, args.verbose)
    if not chromecasts:
        print("No devices found.")
        browser.stop_discovery()
        return

    target = select_device(chromecasts, args.device)
    if not target:
        print("No device selected.")
        browser.stop_discovery()
        return

    try:
        target_name = getattr(target, 'name', 'Device')
        if args.verbose:
            print(f"Connecting to {target_name}...")
        target.wait()
        
        mc = target.media_controller
        # Force status update and wait a bit for response
        mc.update_status()
        time.sleep(0.5) 
        
        status = mc.status
        
        print(f"\nStatus for {target_name}:")
        print("-" * 40)
        
        player_state = getattr(status, 'player_state', 'UNKNOWN')
        print(f"State:     {player_state}")
        
        # App info (from cast status, not media status)
        cast_status = target.status
        display_name = getattr(cast_status, 'display_name', None)
        if display_name:
            print(f"App:       {display_name}")
            
        # Media info
        if player_state != 'IDLE' or status.content_id:
            if hasattr(status, 'title') and status.title:
                print(f"Title:     {status.title}")
            if hasattr(status, 'artist') and status.artist:
                print(f"Artist:    {status.artist}")
            if hasattr(status, 'album_name') and status.album_name:
                print(f"Album:     {status.album_name}")
            
            # Content ID/URL
            if status.content_id:
                print(f"Content:   {status.content_id}")
            
            # Progress
            if hasattr(status, 'duration') and status.duration:
                curr = getattr(status, 'current_time', 0) or 0
                dur = status.duration
                perc = (curr / dur) * 100
                
                # Simple progress bar
                bar_len = 20
                filled = int(bar_len * (curr / dur))
                bar = "=" * filled + "-" * (bar_len - filled)
                
                print(f"Progress:  [{bar}] {perc:.1f}% ({int(curr)}s / {int(dur)}s)")
            elif getattr(status, 'current_time', None):
                print(f"Time:      {int(status.current_time)}s")
        elif not display_name or display_name == "Backdrop":
            print("Nothing is currently playing.")
            
        # Volume
        vol = getattr(cast_status, 'volume_level', 0)
        muted = " (MUTED)" if getattr(cast_status, 'volume_muted', False) else ""
        print(f"Volume:    {int(vol * 100)}%{muted}")
        print("-" * 40)
            
    except Exception as e:
        print(f"Error: {e}")
    finally:
        browser.stop_discovery()

def main():
    example_usage = """examples:
  gcast list
  gcast play --device "Snowy"
  gcast play --device "Living Room" --url http://example.com/song.mp3
  gcast stop --device "Snowy"
  gcast say --device "Snowy" --message "Hello world" --volume 0.5
  gcast volume --device "Snowy"
  gcast volume --device "Snowy" --set 0.6
  gcast status --device "Snowy"
  gcast pause --device "Snowy"
  gcast resume --device "Snowy"
"""
    parser = argparse.ArgumentParser(
        description="Google Cast Discovery & Control Tool",
        epilog=example_usage,
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--verbose", action="store_true", help="Enable verbose logging")
    parser.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    
    subparsers = parser.add_subparsers(dest="command", help="Command to run")
    
    # List command
    list_parser = subparsers.add_parser("list", help="List discovered devices")
    list_parser.add_argument("--timeout", type=int, default=5, help="Discovery timeout")
    list_parser.add_argument("--json", action="store_true", help="Output JSON")

    # Play command
    play_parser = subparsers.add_parser("play", help="Play audio on a device")
    play_parser.add_argument("--device", type=str, help="Target device name (or part of it)")
    play_parser.add_argument("--url", type=str, default=DEFAULT_MEDIA_URL, help="Media URL to play")
    play_parser.add_argument("--volume", type=float, help="Set volume (0.0 - 1.0)")
    play_parser.add_argument("--timeout", type=int, default=5, help="Discovery timeout")

    # Stop command
    stop_parser = subparsers.add_parser("stop", help="Stop playback on a device")
    stop_parser.add_argument("--device", type=str, help="Target device name (or part of it)")
    stop_parser.add_argument("--timeout", type=int, default=5, help="Discovery timeout")

    # Say command
    say_parser = subparsers.add_parser("say", help="Speak text on a device")
    say_parser.add_argument("--device", type=str, help="Target device name (or part of it)")
    say_parser.add_argument("--message", type=str, required=True, help="Text to speak")
    say_parser.add_argument("--volume", type=float, help="Set volume (0.0 - 1.0)")
    say_parser.add_argument("--timeout", type=int, default=5, help="Discovery timeout")

    # Volume command
    volume_parser = subparsers.add_parser("volume", help="Get or set device volume")
    volume_parser.add_argument("--device", type=str, help="Target device name (or part of it)")
    volume_parser.add_argument("--set", type=float, help="Set volume (0.0 - 1.0)")
    volume_parser.add_argument("--timeout", type=int, default=5, help="Discovery timeout")

    # Status command
    status_parser = subparsers.add_parser("status", help="Show current playback status")
    status_parser.add_argument("--device", type=str, help="Target device name (or part of it)")
    status_parser.add_argument("--timeout", type=int, default=5, help="Discovery timeout")

    # Pause command
    pause_parser = subparsers.add_parser("pause", help="Pause playback on a device")
    pause_parser.add_argument("--device", type=str, help="Target device name (or part of it)")
    pause_parser.add_argument("--timeout", type=int, default=5, help="Discovery timeout")

    # Resume command
    resume_parser = subparsers.add_parser("resume", help="Resume playback on a device")
    resume_parser.add_argument("--device", type=str, help="Target device name (or part of it)")
    resume_parser.add_argument("--timeout", type=int, default=5, help="Discovery timeout")

    args = parser.parse_args()

    if args.verbose:
        logging.basicConfig(level=logging.DEBUG)

    if args.command == "list":
        handle_list(args)
    elif args.command == "play":
        handle_play(args)
    elif args.command == "stop":
        handle_stop(args)
    elif args.command == "say":
        handle_say(args)
    elif args.command == "volume":
        handle_volume(args)
    elif args.command == "status":
        handle_status(args)
    elif args.command == "pause":
        handle_pause(args)
    elif args.command == "resume":
        handle_resume(args)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
